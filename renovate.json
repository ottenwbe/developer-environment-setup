{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "onboarding": false,
  "vulnerabilityAlerts": {
    "enabled": false
  },
  "prHourlyLimit": 0,
  "packageRules": [
    {
      "matchPackageNames": ["idea", "gradle"],
      "groupName": "Java Development Tools"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/defaults/main\\.yml$/"],
      "matchStrings": [
        "(?<variableName>[a-zA-Z0-9_]+_version):\\s*['\"](?<currentValue>.+?)['\"]\\s*#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)(?:\\s+versioning=(?<versioning>\\S+))?"
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/.+\\.yml$/"],
      "matchStrings": [
        "fedora_version: \\[(?<currentValue>.+?)\\]\\s*#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)"
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/Dockerfile\\.fedora$/"],
      "matchStrings": [
        "ARG FEDORA_VERSION=(?<currentValue>.+?)\\s*#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)"
      ]
    }
  ]
}